# ---------------------------------------------------------------------------
# Build-time environment. This site is a static export: every NEXT_PUBLIC_ value
# is INLINED INTO THE JAVASCRIPT BUNDLE at `npm run build` and is readable by
# anyone who views source. Never put a private API key, SMTP password, or any
# other secret in this file or in any NEXT_PUBLIC_ variable. A static site has
# no server to keep a secret on.
# ---------------------------------------------------------------------------

# Canonical origin. Drives sitemap.xml, robots.txt, canonical tags and absolute
# og:image URLs. Must match the domain you actually serve, or search engines and
# social crawlers will be pointed at the wrong host.
NEXT_PUBLIC_SITE_URL=https://auralgraphix.com

# Where the contact form POSTs its JSON. Must be an endpoint that accepts a
# cross-origin request from the browser and is safe to expose publicly — a form
# backend's submit URL (Formspree, Getform, Basin) or an EmailJS-style public
# endpoint. These identifiers are designed to be public; the secret half of the
# service stays in that service's dashboard, never here.
# Unset => the form shows its error state and logs to the console.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
